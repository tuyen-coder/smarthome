# ==========================================
# CẤU HÌNH CHUNG (APP SETTINGS)
# ==========================================
APP_NAME="Smart Home API"
ENVIRONMENT="development"
API_V1_PREFIX="/api/v1"

# ==========================================
# BẢO MẬT (SECURITY)
# ==========================================
SECRET_KEY="your-secret-key-here-at-least-32-characters"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==========================================
# CƠ SỞ DỮ LIỆU (DATABASE)
# ==========================================
DATABASE_URL="postgresql+asyncpg://postgres:your_password@localhost:5432/smarthome"

# ==========================================
# CORS (Các domain được phép gọi API)
# ==========================================
# Trong Pydantic, list thường được parse dưới dạng JSON array từ file .env
CORS_ORIGINS='["*"]' 
# Ví dụ nếu chỉ cho phép Frontend React/Vue gọi: CORS_ORIGINS='["http://localhost:3000", "http://localhost:8081"]'

# ==========================================
# MQTT (CẤU HÌNH KẾT NỐI IOT - ADAFRUIT)
# ==========================================
MQTT_ENABLED=True
MQTT_HOST="io.adafruit.com"
MQTT_PORT=8883

# THAY THẾ BẰNG THÔNG TIN ADAFRUIT THẬT CỦA BẠN:
MQTT_USERNAME="your_adafruit_username"
MQTT_KEY="your_adafruit_aio_key"
MQTT_TOPIC_PREFIX="your_adafruit_username/feeds"
